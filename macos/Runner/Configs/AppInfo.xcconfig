// Configuración de la aplicación para el target Runner de macOS.
// Estos valores no provienen automáticamente de pubspec.yaml; si se cambia la
// identidad comercial, deben mantenerse alineados con las demás plataformas.

// Nombre de la aplicación y, por defecto, título de su ventana.
PRODUCT_NAME = homeservicesv

// Identificador único del bundle de macOS.
PRODUCT_BUNDLE_IDENTIFIER = com.example.homeservicesv

// Texto mostrado en la información de la aplicación.
PRODUCT_COPYRIGHT = Copyright © 2026 com.example. All rights reserved.
