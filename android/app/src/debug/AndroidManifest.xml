<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internet es necesario durante el desarrollo para que Flutter se comunique
         con la aplicación y habilite depuración y recarga en caliente.
         Este manifiesto no se incluye en release; la app de producción debe
         declarar Internet también en src/main/AndroidManifest.xml.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
