<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- android:label es el nombre visible bajo el ícono. Cámbialo junto con
         los metadatos web/iOS cuando se defina el nombre comercial final. -->
    <application
        android:label="homeservicesv"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Tema que Android muestra mientras Flutter inicia. Si se modifica,
                 debe conservar coherencia con la pantalla de lanzamiento para
                 evitar un parpadeo antes de que aparezca la interfaz Flutter. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- No eliminar: Flutter usa estos metadatos para registrar los plugins
             nativos incluidos por las dependencias del proyecto. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Permite consultar aplicaciones capaces de procesar texto seleccionado.
         Flutter lo usa para la integración de acciones de texto del sistema:
         https://developer.android.com/training/package-visibility -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

    <!-- Permisos de ubicación para definir direcciones y cobertura. Si se
         elimina alguno, hay que revisar el flujo y el manejo de permisos en Dart. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
</manifest>
