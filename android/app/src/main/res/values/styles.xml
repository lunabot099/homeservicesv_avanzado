<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema visible mientras Android inicia el proceso con el modo oscuro desactivado. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Muestra el fondo de inicio y se retira cuando Flutter dibuja
             el primer fotograma. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema de la ventana después de iniciar el proceso. Define el fondo
         mientras carga Flutter y detrás de su interfaz. Se usa con el
         embedding Android V2 de Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
